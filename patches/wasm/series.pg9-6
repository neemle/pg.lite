pg12/0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
pg9-6/0005-wasm-semaphores.patch
pg11/0006-wasm-dsm-sysv.patch|pg9-6/0006-wasm-dsm-sysv-r9.6.10.patch
pg9-6/0007-wasm-embedded-protocol.patch
0008-wasm-storage-barrier.patch
pg9-6/0009-wasm-walker-signature.patch|pg9-6/0009-wasm-walker-signature-r9.6.9.patch
