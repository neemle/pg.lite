# Patch series for the "wasm" target, range pg9-4 (PostgreSQL 9.x): one *.patch path per line, relative to this directory.
# Made by scripts/port-patches.js from the baseline series (9.5.25); entries in pg9-4/ are the patches that needed a port, the others are shared with the baseline.
pg9-4/0001-wasm-shared-memory.patch
pg11/0002-wasm-no-root-check.patch
pg12/0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
pg9-4/0005-wasm-semaphores.patch
pg11/0006-wasm-dsm-sysv.patch
pg9-4/0007-wasm-embedded-protocol.patch
0008-wasm-storage-barrier.patch
