pg11/0002-wasm-no-root-check.patch
pg12/0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
pg9-5/0005-wasm-semaphores.patch
pg11/0006-wasm-dsm-sysv.patch|pg9-5/0006-wasm-dsm-sysv-r9.5.14.patch
pg9-5/0007-wasm-embedded-protocol.patch
0008-wasm-storage-barrier.patch
