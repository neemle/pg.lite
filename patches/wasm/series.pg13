# Patch series for the "wasm" target, range pg13 (PostgreSQL 13.x): one *.patch path per line, relative to this directory.
# Made by scripts/port-patches.js from the baseline series (14.24); entries in pg13/ are the patches that needed a port, the others are shared with the baseline.
0001-wasm-shared-memory.patch
0002-wasm-no-root-check.patch
0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
0005-wasm-semaphores.patch
pg14/0006-wasm-dsm-sysv.patch
pg13/0007-wasm-embedded-protocol.patch|pg13/0007-wasm-embedded-protocol-r13.15.patch|pg13/0007-wasm-embedded-protocol-r13.13.patch
0008-wasm-storage-barrier.patch
pg13/0009-wasm-walker-signature.patch|-
