# Patch series for the "wasm" target, range pg16 (PostgreSQL 16.x): one *.patch path per line, relative to this directory.
# Made by scripts/port-patches.js from the baseline series (18.6); entries in pg16/ are the patches that needed a port, the others are shared with the baseline.
0001-wasm-shared-memory.patch
0002-wasm-no-root-check.patch
0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
0005-wasm-semaphores.patch
0006-wasm-dsm-sysv.patch
pg16/0007-wasm-embedded-protocol.patch
0008-wasm-storage-barrier.patch
