# Patch series for the "wasm" target, range pg10 (PostgreSQL 10.x): one *.patch path per line, relative to this directory.
# Made by scripts/port-patches.js from the baseline series (11.22); entries in pg10/ are the patches that needed a port, the others are shared with the baseline.
pg11/0001-wasm-shared-memory.patch
pg11/0002-wasm-no-root-check.patch
pg12/0003-wasm-initdb-popen.patch
0004-wasm-user-name.patch
pg11/0005-wasm-semaphores.patch
pg11/0006-wasm-dsm-sysv.patch|pg10/0006-wasm-dsm-sysv-r10.5.patch
pg10/0007-wasm-embedded-protocol.patch
0008-wasm-storage-barrier.patch
pg10/0009-wasm-walker-signature.patch|pg10/0009-wasm-walker-signature-r10.5.patch|pg10/0009-wasm-walker-signature-r10.14.patch|-
