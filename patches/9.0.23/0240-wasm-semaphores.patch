diff --git a/src/backend/port/wasm_sema.c b/src/backend/port/wasm_sema.c
new file mode 100644
--- a/src/backend/port/wasm_sema.c
+++ b/src/backend/port/wasm_sema.c
@@ -0,0 +1,268 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_sema.c
+ *	  POSIX unnamed semaphores for a single-process WebAssembly build.
+ *
+ * configure picks unnamed POSIX semaphores because Emscripten links sem_init()
+ * and its relatives, but without threads they are stubs: sem_init() fails and
+ * sem_trywait() always reports success, so PGSemaphoreReset(), which takes a
+ * semaphore down to zero by calling sem_trywait() until it fails, never ends.
+ * With one process nothing can post a semaphore that another is waiting on, so
+ * a plain counter is all PostgreSQL needs: waiting on a semaphore that is zero
+ * could never end and is reported as an error instead of hanging.  These
+ * definitions are used by posix_sema.c in place of the C library's (port/wasm_sema.h).
+ *
+ * src/backend/port/wasm_sema.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifdef __EMSCRIPTEN__
+
+#include "postgres.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <semaphore.h>
+
+#include "port/wasm_sema.h"
+
+int
+wasm_sem_init(sem_t *sem, int pshared, unsigned int value)
+{
+	if (value > (unsigned int) INT_MAX)
+	{
+		errno = EINVAL;
+		return -1;
+	}
+	sem->__val[0] = (int) value;
+	return 0;
+}
+
+int
+wasm_sem_destroy(sem_t *sem)
+{
+	return 0;
+}
+
+int
+wasm_sem_post(sem_t *sem)
+{
+	if (sem->__val[0] == INT_MAX)
+	{
+		errno = EOVERFLOW;
+		return -1;
+	}
+	sem->__val[0]++;
+	return 0;
+}
+
+int
+wasm_sem_trywait(sem_t *sem)
+{
+	if (sem->__val[0] > 0)
+	{
+		sem->__val[0]--;
+		return 0;
+	}
+	errno = EAGAIN;
+	return -1;
+}
+
+int
+wasm_sem_wait(sem_t *sem)
+{
+	if (wasm_sem_trywait(sem) == 0)
+		return 0;
+	/* no other process or thread could ever post it: a wait here would be forever */
+	errno = EDEADLK;
+	return -1;
+}
+
+
+/*
+ * System V semaphores.  PostgreSQL releases before 10 use them on Linux (the POSIX ones need thread safety there, which
+ * a WebAssembly build cannot have), and Emscripten has no semget() and friends.  A set is an array of counters in the
+ * memory of this process.  Waiting on a counter that is too small could never end (no other process or thread would
+ * raise it), so it fails with EDEADLK, which PostgreSQL reports as an error, instead of hanging.
+ */
+#include <stdarg.h>
+#include <stdlib.h>
+#include <sys/ipc.h>
+#include <sys/sem.h>
+
+#define WASM_SEM_SETS 256
+
+typedef struct WasmSemSet
+{
+	bool		used;
+	key_t		key;
+	int			nsems;
+	int		   *value;
+} WasmSemSet;
+
+/* the argument of semctl(): passed by value like PostgreSQL's own union semun (same size, same passing convention) */
+union wasm_semun
+{
+	int			val;
+	void	   *ptr;
+};
+
+static WasmSemSet wasm_sem_sets[WASM_SEM_SETS];
+
+static WasmSemSet *
+wasm_sem_find(int semid)
+{
+	if (semid < 0 || semid >= WASM_SEM_SETS || !wasm_sem_sets[semid].used)
+	{
+		errno = EINVAL;
+		return NULL;
+	}
+	return &wasm_sem_sets[semid];
+}
+
+int
+semget(key_t key, int nsems, int flags)
+{
+	int			i;
+
+	if (key != IPC_PRIVATE)
+	{
+		for (i = 0; i < WASM_SEM_SETS; i++)
+		{
+			if (wasm_sem_sets[i].used && wasm_sem_sets[i].key == key)
+			{
+				if ((flags & IPC_CREAT) && (flags & IPC_EXCL))
+				{
+					errno = EEXIST;
+					return -1;
+				}
+				if (nsems > wasm_sem_sets[i].nsems)
+				{
+					errno = EINVAL;
+					return -1;
+				}
+				return i;
+			}
+		}
+		if (!(flags & IPC_CREAT))
+		{
+			errno = ENOENT;
+			return -1;
+		}
+	}
+	for (i = 0; i < WASM_SEM_SETS; i++)
+	{
+		if (!wasm_sem_sets[i].used)
+		{
+			wasm_sem_sets[i].value = calloc(nsems > 0 ? nsems : 1, sizeof(int));
+			if (wasm_sem_sets[i].value == NULL)
+			{
+				errno = ENOMEM;
+				return -1;
+			}
+			wasm_sem_sets[i].used = true;
+			wasm_sem_sets[i].key = key;
+			wasm_sem_sets[i].nsems = nsems;
+			return i;
+		}
+	}
+	errno = ENOSPC;
+	return -1;
+}
+
+int
+semctl(int semid, int semnum, int cmd, ...)
+{
+	WasmSemSet *s = wasm_sem_find(semid);
+	va_list		ap;
+	int			result = 0;
+
+	if (s == NULL)
+		return -1;
+	va_start(ap, cmd);
+	switch (cmd)
+	{
+		case IPC_RMID:
+			free(s->value);
+			s->value = NULL;
+			s->used = false;
+			break;
+		case SETVAL:
+			{
+				union wasm_semun arg = va_arg(ap, union wasm_semun);
+
+				if (semnum < 0 || semnum >= s->nsems)
+				{
+					errno = EINVAL;
+					result = -1;
+				}
+				else
+					s->value[semnum] = arg.val;
+			}
+			break;
+		case GETVAL:
+			if (semnum < 0 || semnum >= s->nsems)
+			{
+				errno = EINVAL;
+				result = -1;
+			}
+			else
+				result = s->value[semnum];
+			break;
+		case GETPID:
+			result = 1;
+			break;
+		case GETNCNT:
+		case GETZCNT:
+			result = 0;
+			break;
+		case IPC_STAT:
+			{
+				union wasm_semun arg = va_arg(ap, union wasm_semun);
+				struct semid_ds *buf = (struct semid_ds *) arg.ptr;
+
+				memset(buf, 0, sizeof(*buf));
+				buf->sem_nsems = s->nsems;
+				buf->sem_perm.uid = geteuid();
+				buf->sem_perm.cuid = geteuid();
+			}
+			break;
+		default:
+			errno = EINVAL;
+			result = -1;
+			break;
+	}
+	va_end(ap);
+	return result;
+}
+
+int
+semop(int semid, struct sembuf *sops, size_t nsops)
+{
+	WasmSemSet *s = wasm_sem_find(semid);
+	size_t		i;
+
+	if (s == NULL)
+		return -1;
+	/* all or nothing: check every operation first */
+	for (i = 0; i < nsops; i++)
+	{
+		int			n = sops[i].sem_num;
+		int			op = sops[i].sem_op;
+
+		if (n >= s->nsems)
+		{
+			errno = EFBIG;
+			return -1;
+		}
+		if ((op < 0 && s->value[n] + op < 0) || (op == 0 && s->value[n] != 0))
+		{
+			errno = (sops[i].sem_flg & IPC_NOWAIT) ? EAGAIN : EDEADLK;
+			return -1;
+		}
+	}
+	for (i = 0; i < nsops; i++)
+		s->value[sops[i].sem_num] += sops[i].sem_op;
+	return 0;
+}
+#endif							/* __EMSCRIPTEN__ */
diff --git a/src/include/port/wasm_sema.h b/src/include/port/wasm_sema.h
new file mode 100644
--- a/src/include/port/wasm_sema.h
+++ b/src/include/port/wasm_sema.h
@@ -0,0 +1,30 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_sema.h
+ *	  Semaphore calls of a single-process WebAssembly build (wasm_sema.c).
+ *
+ * The C library's semaphore functions are stubs without threads, so
+ * posix_sema.c is given these in their place.
+ *
+ * src/include/port/wasm_sema.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef WASM_SEMA_H
+#define WASM_SEMA_H
+
+#include <semaphore.h>
+
+extern int	wasm_sem_init(sem_t *sem, int pshared, unsigned int value);
+extern int	wasm_sem_destroy(sem_t *sem);
+extern int	wasm_sem_post(sem_t *sem);
+extern int	wasm_sem_trywait(sem_t *sem);
+extern int	wasm_sem_wait(sem_t *sem);
+
+#define sem_init wasm_sem_init
+#define sem_destroy wasm_sem_destroy
+#define sem_post wasm_sem_post
+#define sem_trywait wasm_sem_trywait
+#define sem_wait wasm_sem_wait
+
+#endif							/* WASM_SEMA_H */
