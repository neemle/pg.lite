 extern int	embedded_pg_dump_main(int argc, char **argv) __attribute__((weak));
 extern int	embedded_pg_restore_main(int argc, char **argv) __attribute__((weak));
+extern int	embedded_pg_isready_main(int argc, char **argv) __attribute__((weak));
 
 /* the C library functions the linker wraps */
 extern int	__real_open(const char *path, int flags, ...);
@@ -1356,6 +1357,62 @@
