Targets: wasm
Releases: 9.0.0-9.0.23
Subject: Move the protocol bytes of the WebAssembly backend through JavaScript calls
Purpose: pqcomm.c reads and writes the frontend/backend protocol through a socket; the embedded engine of the WebAssembly build has none (MyProcPort stays NULL, the client is JavaScript), so its reads and writes go through wasm_embed_read() and wasm_embed_write() (patch 0260) and the calls that switch a socket between blocking and non-blocking mode do nothing. It is a patch of its own because pqcomm.c differs from one series to the next (9.1 added non-blocking socket handling that would dereference the missing Port): one variant per series.
Components: src/backend/libpq/pqcomm.c
Checks: wasm/tests/browser runs queries through the wire protocol in Chromium
Origin: own

diff --git a/src/backend/libpq/pqcomm.c b/src/backend/libpq/pqcomm.c
--- a/src/backend/libpq/pqcomm.c
+++ b/src/backend/libpq/pqcomm.c
@@ -90,6 +90,10 @@
 #include "libpq/ip.h"
 #include "libpq/libpq.h"
 #include "miscadmin.h"
+#ifdef __EMSCRIPTEN__
+#include "port/wasm_embed.h"
+#include "tcop/tcopprot.h"
+#endif
 #include "storage/ipc.h"
 #include "utils/guc.h"
 
@@ -784,8 +788,14 @@
 	{
 		int			r;
 
-		r = secure_read(MyProcPort, PqRecvBuffer + PqRecvLength,
-						PQ_BUFFER_SIZE - PqRecvLength);
+#ifdef __EMSCRIPTEN__
+		if (wasm_embedded)
+			r = wasm_embed_read(PqRecvBuffer + PqRecvLength,
+								PQ_BUFFER_SIZE - PqRecvLength);
+		else
+#endif
+			r = secure_read(MyProcPort, PqRecvBuffer + PqRecvLength,
+							PQ_BUFFER_SIZE - PqRecvLength);
 
 		if (r < 0)
 		{
@@ -872,6 +882,12 @@
 		return 1;
 	}
 
+#ifdef __EMSCRIPTEN__
+	/* the client is JavaScript: nothing arrives while a query runs */
+	if (wasm_embedded)
+		return 0;
+#endif
+
 	/* Temporarily put the socket into non-blocking mode */
 #ifdef WIN32
 	pgwin32_noblock = 1;
@@ -1277,7 +1293,12 @@
 	{
 		int			r;
 
-		r = secure_write(MyProcPort, bufptr, bufend - bufptr);
+#ifdef __EMSCRIPTEN__
+		if (wasm_embedded)
+			r = wasm_embed_write(bufptr, (int) (bufend - bufptr));
+		else
+#endif
+			r = secure_write(MyProcPort, bufptr, bufend - bufptr);
 
 		if (r <= 0)
 		{
@@ -1711,3 +1732,23 @@
 
 	return STATUS_OK;
 }
+#ifdef __EMSCRIPTEN__
+/* --------------------------------
+ *		pq_init_embedded - protocol state for a JavaScript client
+ *
+ * Counterpart of pq_init() for the standalone backend of the WebAssembly
+ * build, which has no socket and no Port (MyProcPort stays NULL): reset
+ * the (static) buffers, speak protocol 3 and send results "remote", so that
+ * PostgresMain() behaves as in a client backend.  Bytes move through
+ * wasm_embed_read() and wasm_embed_write() (port/wasm_embed.c).
+ * --------------------------------
+ */
+void
+pq_init_embedded(void)
+{
+	PqSendPointer = PqRecvPointer = PqRecvLength = 0;
+	PqCommBusy = false;
+	FrontendProtocol = PG_PROTOCOL(3, 0);
+	whereToSendOutput = DestRemote;
+}
+#endif							/* __EMSCRIPTEN__ */
