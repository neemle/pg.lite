Targets: common
Releases: 9.0.0-
Subject: Keep the encoding conversions in the static server
Purpose: The conversions between UTF8, the server encodings and MULE_INTERNAL are modules (src/backend/utils/mb/conversion_procs, 26 of them) that initdb creates from conversion_create.sql with $libdir/<module> as their library. A static executable cannot load them, so they are linked into postgres like plpgsql and dict_snowball and registered in a second table that the same lookup consults (staticmods_conv.inc, generated from the PG_FUNCTION_INFO_V1 lists of the module sources); conversion_create.sql then stays as the release installs it. Without this patch the server would have no conversions: CREATE DATABASE with an encoding other than UTF8 and SQL_ASCII, and client_encoding other than the server's, would fail.
Components: src/backend/utils/fmgr/staticmods.c, src/backend/utils/fmgr/staticmods_conv.inc (new)
Checks: scripts/native-image.sh test and tests/wasm/test-wasm-node.sh convert text between UTF8 and LATIN1, WIN1251 and EUC_JP through convert_to/convert_from and a client_encoding change
Origin: own

diff --git a/src/backend/utils/fmgr/staticmods.c b/src/backend/utils/fmgr/staticmods.c
--- a/src/backend/utils/fmgr/staticmods.c
+++ b/src/backend/utils/fmgr/staticmods.c
@@ -73,6 +73,8 @@
 	{NULL, NULL, false}
 };
 
+#include "staticmods_conv.inc"
+
 StaticModule *
 static_module_find(const char *libname)
 {
@@ -95,6 +97,12 @@
 			m->syms[0].addr != NULL)
 			return m;
 	}
+	for (StaticModule *m = static_conversion_modules; m->name != NULL; m++)
+	{
+		if (strlen(m->name) == len && strncmp(m->name, base, len) == 0 &&
+			m->syms[0].addr != NULL)
+			return m;
+	}
 	return NULL;
 }
 
@@ -126,8 +134,10 @@
 bool
 static_module_is_handle(void *handle)
 {
-	return (StaticModule *) handle >= static_modules &&
-		(StaticModule *) handle < static_modules + lengthof(static_modules);
+	return ((StaticModule *) handle >= static_modules &&
+			(StaticModule *) handle < static_modules + lengthof(static_modules)) ||
+		((StaticModule *) handle >= static_conversion_modules &&
+		 (StaticModule *) handle < static_conversion_modules + lengthof(static_conversion_modules));
 }
 
 const char *
