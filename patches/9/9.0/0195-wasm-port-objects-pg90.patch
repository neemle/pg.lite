Targets: wasm
Releases: 9.0.0-9.0.23
Subject: Build the WebAssembly port files into the backend
Purpose: The build file of src/backend/port lists the object files; wasm_shm.o (patch 0200), wasm_sema.o (0240) and wasm_embed.o (0260) have to be in the list. It is a patch of its own because the lines around the list differ from one series to the next: one variant per series.
Components: src/backend/port/Makefile
Checks: wasm/build.sh links postgres with no undefined symbols
Origin: own

diff --git a/src/backend/port/Makefile b/src/backend/port/Makefile
--- a/src/backend/port/Makefile
+++ b/src/backend/port/Makefile
@@ -21,7 +21,7 @@
 top_builddir = ../../..
 include $(top_builddir)/src/Makefile.global
 
-OBJS = dynloader.o pg_sema.o pg_shmem.o $(TAS)
+OBJS = dynloader.o pg_sema.o pg_shmem.o wasm_shm.o wasm_sema.o wasm_embed.o $(TAS)
 
 ifeq ($(PORTNAME), darwin)
 SUBDIRS += darwin
