diff --git a/src/backend/utils/fmgr/staticmods.c b/src/backend/utils/fmgr/staticmods.c
new file mode 100644
--- a/src/backend/utils/fmgr/staticmods.c
+++ b/src/backend/utils/fmgr/staticmods.c
@@ -0,0 +1,152 @@
+/*-------------------------------------------------------------------------
+ *
+ * staticmods.c
+ *	  Registry of loadable modules that are linked into the server executable.
+ *
+ * See utils/static_modules.h.  The module objects are built by the normal
+ * module Makefiles, combined with "ld -r" and given unique names for their
+ * Pg_magic_func and _PG_init symbols (objcopy --redefine-sym), then passed to
+ * the backend link through STATIC_MODULE_OBJS.  Every reference below is weak,
+ * so a server linked without them still builds and simply has no static modules.
+ *
+ * The ABI check that internal_load_library() does with the magic block is
+ * skipped on purpose: the modules are compiled from the same tree and headers
+ * as the server, so they cannot be incompatible with it.
+ *
+ * src/backend/utils/fmgr/staticmods.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "fmgr.h"
+#include "utils/static_modules.h"
+
+#define WEAK __attribute__((weak))
+
+typedef void (*PG_init_t) (void);
+
+/* plpgsql (src/pl/plpgsql/src), symbols renamed at link preparation */
+extern const Pg_magic_struct *plpgsql_Pg_magic_func(void) WEAK;
+extern void plpgsql_PG_init(void) WEAK;
+extern Datum plpgsql_call_handler(PG_FUNCTION_ARGS) WEAK;
+extern Datum plpgsql_inline_handler(PG_FUNCTION_ARGS) WEAK;
+extern Datum plpgsql_validator(PG_FUNCTION_ARGS) WEAK;
+extern const Pg_finfo_record *pg_finfo_plpgsql_call_handler(void) WEAK;
+extern const Pg_finfo_record *pg_finfo_plpgsql_inline_handler(void) WEAK;
+extern const Pg_finfo_record *pg_finfo_plpgsql_validator(void) WEAK;
+
+/* dict_snowball (src/backend/snowball) */
+extern const Pg_magic_struct *dict_snowball_Pg_magic_func(void) WEAK;
+extern void dict_snowball_PG_init(void) WEAK;
+extern Datum dsnowball_init(PG_FUNCTION_ARGS) WEAK;
+extern Datum dsnowball_lexize(PG_FUNCTION_ARGS) WEAK;
+extern const Pg_finfo_record *pg_finfo_dsnowball_init(void) WEAK;
+extern const Pg_finfo_record *pg_finfo_dsnowball_lexize(void) WEAK;
+
+/* The first entry of every table is Pg_magic_func: NULL there means "not linked in" */
+static const StaticModuleSym plpgsql_syms[] = {
+	{"Pg_magic_func", (void *) plpgsql_Pg_magic_func},
+	{"_PG_init", (void *) plpgsql_PG_init},
+	{"plpgsql_call_handler", (void *) plpgsql_call_handler},
+	{"plpgsql_inline_handler", (void *) plpgsql_inline_handler},
+	{"plpgsql_validator", (void *) plpgsql_validator},
+	{"pg_finfo_plpgsql_call_handler", (void *) pg_finfo_plpgsql_call_handler},
+	{"pg_finfo_plpgsql_inline_handler", (void *) pg_finfo_plpgsql_inline_handler},
+	{"pg_finfo_plpgsql_validator", (void *) pg_finfo_plpgsql_validator},
+	{NULL, NULL}
+};
+
+static const StaticModuleSym dict_snowball_syms[] = {
+	{"Pg_magic_func", (void *) dict_snowball_Pg_magic_func},
+	{"_PG_init", (void *) dict_snowball_PG_init},
+	{"dsnowball_init", (void *) dsnowball_init},
+	{"dsnowball_lexize", (void *) dsnowball_lexize},
+	{"pg_finfo_dsnowball_init", (void *) pg_finfo_dsnowball_init},
+	{"pg_finfo_dsnowball_lexize", (void *) pg_finfo_dsnowball_lexize},
+	{NULL, NULL}
+};
+
+static StaticModule static_modules[] = {
+	{"plpgsql", plpgsql_syms, false},
+	{"dict_snowball", dict_snowball_syms, false},
+	{NULL, NULL, false}
+};
+
+StaticModule *
+static_module_find(const char *libname)
+{
+	const char *base = libname;
+	const char *slash;
+	size_t		len;
+
+	if (strncmp(base, "$libdir/", 8) == 0)
+		base += 8;
+	slash = strrchr(base, '/');
+	if (slash != NULL)
+		base = slash + 1;
+	len = strlen(base);
+	if (len > 3 && strcmp(base + len - 3, ".so") == 0)
+		len -= 3;
+
+	for (StaticModule *m = static_modules; m->name != NULL; m++)
+	{
+		if (strlen(m->name) == len && strncmp(m->name, base, len) == 0 &&
+			m->syms[0].addr != NULL)
+			return m;
+	}
+	return NULL;
+}
+
+void
+static_module_load(StaticModule *module)
+{
+	PG_init_t	init;
+
+	if (module->loaded)
+		return;
+	module->loaded = true;
+
+	init = (PG_init_t) static_module_lookup(module, "_PG_init");
+	if (init != NULL)
+		(*init) ();
+}
+
+void *
+static_module_lookup(StaticModule *module, const char *symbol)
+{
+	for (const StaticModuleSym *s = module->syms; s->name != NULL; s++)
+	{
+		if (strcmp(s->name, symbol) == 0)
+			return s->addr;
+	}
+	return NULL;
+}
+
+bool
+static_module_is_handle(void *handle)
+{
+	return (StaticModule *) handle >= static_modules &&
+		(StaticModule *) handle < static_modules + lengthof(static_modules);
+}
+
+const char *
+static_module_names(void)
+{
+	static char names[128];
+
+	if (names[0] == '\0')
+	{
+		for (StaticModule *m = static_modules; m->name != NULL; m++)
+		{
+			if (m->syms[0].addr == NULL)
+				continue;
+			if (names[0] != '\0')
+				strlcat(names, ", ", sizeof(names));
+			strlcat(names, m->name, sizeof(names));
+		}
+		if (names[0] == '\0')
+			strlcpy(names, "none", sizeof(names));
+	}
+	return names;
+}
diff --git a/src/include/utils/static_modules.h b/src/include/utils/static_modules.h
new file mode 100644
--- a/src/include/utils/static_modules.h
+++ b/src/include/utils/static_modules.h
@@ -0,0 +1,48 @@
+/*-------------------------------------------------------------------------
+ *
+ * static_modules.h
+ *	  Loadable modules that are linked into the server executable.
+ *
+ * A statically linked server cannot dlopen() anything.  The few modules that
+ * the standard bootstrap needs (plpgsql, dict_snowball) are linked into the
+ * executable instead and registered here, so that load_external_function() and
+ * LOAD resolve them without the dynamic loader.  Only used when
+ * PG_STATIC_MODULES is defined.
+ *
+ * src/include/utils/static_modules.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef STATIC_MODULES_H
+#define STATIC_MODULES_H
+
+/* One exported symbol of a module: the name dlsym() would be asked for */
+typedef struct StaticModuleSym
+{
+	const char *name;
+	void	   *addr;			/* NULL if the module is not linked in */
+} StaticModuleSym;
+
+typedef struct StaticModule
+{
+	const char *name;			/* library name without directory or suffix */
+	const StaticModuleSym *syms;	/* terminated by an entry with name NULL */
+	bool		loaded;			/* _PG_init already called? */
+} StaticModule;
+
+/* Find a linked-in module by library name ("plpgsql", "$libdir/plpgsql", ...) */
+extern StaticModule *static_module_find(const char *libname);
+
+/* Run the module's _PG_init once */
+extern void static_module_load(StaticModule *module);
+
+/* dlsym() replacement; NULL if the symbol is unknown */
+extern void *static_module_lookup(StaticModule *module, const char *symbol);
+
+/* Is this pointer one of the handles static_module_find() returns? */
+extern bool static_module_is_handle(void *handle);
+
+/* Comma-separated names of the linked-in modules, for messages */
+extern const char *static_module_names(void);
+
+#endif							/* STATIC_MODULES_H */
