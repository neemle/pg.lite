diff --git a/src/backend/port/wasm_embed.c b/src/backend/port/wasm_embed.c
new file mode 100644
--- a/src/backend/port/wasm_embed.c
+++ b/src/backend/port/wasm_embed.c
@@ -0,0 +1,83 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_embed.c
+ *	  Run the single-user backend as a library for JavaScript: the
+ *	  frontend/backend protocol travels through function calls, not a socket.
+ *
+ * A browser has no sockets and no processes.  pg_wasm_main() starts the
+ * standalone backend (postgres --single) with the protocol switched to
+ * "remote" mode: the bytes the backend would send to a client go to
+ * Module.pgWrite(), and when it wants the next message it asks
+ * Module.pgRead(), which returns a Promise.  The wasm stack is suspended
+ * while the Promise is pending (JavaScript Promise Integration), so the
+ * backend's own main loop is used unchanged and any PostgreSQL client
+ * library that speaks the protocol can drive it.  See src/backend/libpq/pqcomm.c
+ * (hooks) and patch wasm/0007.
+ *
+ * The browser link defines PG_WASM_BROWSER; the node build has no such
+ * JavaScript hooks and gets stubs that fail with ENOSYS.
+ *
+ * src/backend/port/wasm_embed.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifdef __EMSCRIPTEN__
+
+#include "postgres.h"
+
+#include <emscripten.h>
+#include <errno.h>
+
+#include "port/wasm_embed.h"
+
+bool		wasm_embedded = false;
+
+#ifdef PG_WASM_BROWSER
+
+/* Module.pgRead(ptr, maxlen) -> Promise of the number of bytes stored at ptr (0 = end of input) */
+EM_ASYNC_JS(int, wasm_embed_read, (char *dst, int maxlen),
+{
+	return await Module.pgRead(dst, maxlen);
+});
+
+/* Module.pgWrite(ptr, len) copies the bytes out and returns len */
+EM_JS(int, wasm_embed_write, (const char *src, int len),
+{
+	return Module.pgWrite(src, len);
+});
+
+#else							/* !PG_WASM_BROWSER */
+
+int
+wasm_embed_read(char *dst, int maxlen)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+int
+wasm_embed_write(const char *src, int len)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+#endif							/* PG_WASM_BROWSER */
+
+extern int	main(int argc, char *argv[]);
+
+/*
+ * Start the backend; returns when the session ends.  The data directory is
+ * /pgdata and the program path /pgsql/bin/postgres (it must exist as a file,
+ * the server finds its share directory relative to it).
+ */
+EMSCRIPTEN_KEEPALIVE int
+pg_wasm_main(void)
+{
+	static char *argv[] = {"/pgsql/bin/postgres", "--single", "-D", "/pgdata", "postgres", NULL};
+
+	wasm_embedded = true;
+	return main(5, argv);
+}
+
+#endif							/* __EMSCRIPTEN__ */
diff --git a/src/include/port/wasm_embed.h b/src/include/port/wasm_embed.h
new file mode 100644
--- a/src/include/port/wasm_embed.h
+++ b/src/include/port/wasm_embed.h
@@ -0,0 +1,25 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_embed.h
+ *	  Protocol-through-function-calls hooks of the WebAssembly backend.
+ *
+ * src/include/port/wasm_embed.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef WASM_EMBED_H
+#define WASM_EMBED_H
+
+/* true while the frontend is JavaScript calling in, not a socket client */
+extern PGDLLIMPORT bool wasm_embedded;
+
+/* blocking read of up to maxlen protocol bytes (0 = end of input, -1 = error with errno) */
+extern int	wasm_embed_read(char *dst, int maxlen);
+
+/* send len protocol bytes to the client; returns len or -1 with errno */
+extern int	wasm_embed_write(const char *src, int len);
+
+/* set up the protocol buffers and the "remote" output destination (pqcomm.c) */
+extern void pq_init_embedded(void);
+
+#endif							/* WASM_EMBED_H */
