-	stem_UTF_8_turkish.o
+OBJS= dict_snowball.o api.o utilities.o stem_UTF_8_english.o
 
 # first column is language name and also name of dictionary for not-all-ASCII
 # words, second is name of dictionary for all-ASCII words
 # Note order dependency: use of some other language as ASCII dictionary
 # must come after creation of that language
 LANGUAGES=  \
-	danish		danish 		\
-	dutch 		dutch 		\
-	english 	english		\
-	finnish 	finnish		\
-	french 		french		\
-	german 		german		\
-	hungarian 	hungarian	\
-	italian 	italian		\
-	norwegian 	norwegian	\
-	portuguese 	portuguese	\
-	romanian 	romanian	\
-	russian 	english		\
-	spanish 	spanish		\
-	swedish 	swedish		\
-	turkish		turkish
+	english		english
 
 
 SQLSCRIPT= snowball_create.sql
