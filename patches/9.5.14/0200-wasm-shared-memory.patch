@@ -0,0 +1,174 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_shm.c
+ *	  System V shared memory calls for a single-process WebAssembly build.
+ *
+ * Emscripten declares no shmget(), shmat(), shmdt() or shmctl().  The server
+ * uses them in two places even when it runs as one process (single-user
+ * mode): sysv_shmem.c creates a small interlock segment next to the
+ * anonymous main segment, and dsm_impl.c creates the dynamic shared memory
+ * control segment.  With no second process there is nothing to share with,
+ * so a segment here is a block of this process's own memory.  Only the
+ * behaviour PostgreSQL relies on is implemented: create (exclusive or
+ * attach to an existing key), attach, detach, IPC_STAT (size and attach
+ * count) and IPC_RMID (freed when the last attachment goes).
+ *
+ * src/backend/port/wasm_shm.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifdef __EMSCRIPTEN__
+
+#include "postgres.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ipc.h>
+#include <sys/shm.h>
+
+#define WASM_SHM_MAX_SEGMENTS 64
+
+typedef struct WasmShmSegment
+{
+	bool		used;
+	bool		removed;
+	key_t		key;
+	size_t		size;
+	void	   *addr;
+	int			nattch;
+} WasmShmSegment;
+
+static WasmShmSegment wasm_segments[WASM_SHM_MAX_SEGMENTS];
+
+static WasmShmSegment *
+wasm_shm_by_id(int shmid)
+{
+	if (shmid < 1 || shmid > WASM_SHM_MAX_SEGMENTS || !wasm_segments[shmid - 1].used)
+		return NULL;
+	return &wasm_segments[shmid - 1];
+}
+
+static void
+wasm_shm_release(WasmShmSegment *seg)
+{
+	free(seg->addr);
+	memset(seg, 0, sizeof(*seg));
+}
+
+int
+shmget(key_t key, size_t size, int shmflg)
+{
+	if (key != IPC_PRIVATE)
+	{
+		for (int i = 0; i < WASM_SHM_MAX_SEGMENTS; i++)
+		{
+			WasmShmSegment *seg = &wasm_segments[i];
+
+			if (!seg->used || seg->removed || seg->key != key)
+				continue;
+			if ((shmflg & IPC_CREAT) && (shmflg & IPC_EXCL))
+			{
+				errno = EEXIST;
+				return -1;
+			}
+			if (size > seg->size)
+			{
+				errno = EINVAL;
+				return -1;
+			}
+			return i + 1;
+		}
+		if (!(shmflg & IPC_CREAT))
+		{
+			errno = ENOENT;
+			return -1;
+		}
+	}
+
+	for (int i = 0; i < WASM_SHM_MAX_SEGMENTS; i++)
+	{
+		WasmShmSegment *seg = &wasm_segments[i];
+
+		if (seg->used)
+			continue;
+		seg->addr = calloc(1, size > 0 ? size : 1);
+		if (seg->addr == NULL)
+		{
+			errno = ENOMEM;
+			return -1;
+		}
+		seg->used = true;
+		seg->removed = false;
+		seg->key = key;
+		seg->size = size;
+		seg->nattch = 0;
+		return i + 1;
+	}
+	errno = ENOSPC;
+	return -1;
+}
+
+void *
+shmat(int shmid, const void *shmaddr, int shmflg)
+{
+	WasmShmSegment *seg = wasm_shm_by_id(shmid);
+
+	if (seg == NULL || shmaddr != NULL)
+	{
+		errno = EINVAL;
+		return (void *) -1;
+	}
+	seg->nattch++;
+	return seg->addr;
+}
+
+int
+shmdt(const void *shmaddr)
+{
+	for (int i = 0; i < WASM_SHM_MAX_SEGMENTS; i++)
+	{
+		WasmShmSegment *seg = &wasm_segments[i];
+
+		if (seg->used && seg->addr == shmaddr)
+		{
+			if (seg->nattch > 0)
+				seg->nattch--;
+			if (seg->removed && seg->nattch == 0)
+				wasm_shm_release(seg);
+			return 0;
+		}
+	}
+	errno = EINVAL;
+	return -1;
+}
+
+int
+shmctl(int shmid, int cmd, struct shmid_ds *buf)
+{
+	WasmShmSegment *seg = wasm_shm_by_id(shmid);
+
+	if (seg == NULL)
+	{
+		errno = EINVAL;
+		return -1;
+	}
+	switch (cmd)
+	{
+		case IPC_STAT:
+			memset(buf, 0, sizeof(*buf));
+			buf->shm_segsz = seg->size;
+			buf->shm_nattch = seg->nattch;
+			return 0;
+		case IPC_RMID:
+			seg->removed = true;
+			if (seg->nattch == 0)
+				wasm_shm_release(seg);
+			return 0;
+		default:
+			errno = EINVAL;
+			return -1;
+	}
+}
+
+#endif							/* __EMSCRIPTEN__ */
