#!/bin/sh
# dc - run any command inside the compact.db tools container. The host only runs docker.
#
#   ./dc make test-locks
#   ./dc make fetch                 (network is enabled automatically for 'fetch')
#   DC_NET=1 ./dc sh -c 'curl -sI https://example.org'
#   ./dc sh                         (interactive shell)
#
# The repo is mounted at /w. Network is OFF unless an argument is exactly 'fetch' or DC_NET=1.
set -eu
root=$(cd "$(dirname "$0")" && pwd)
image="compactdb-tools:local"

# Build is incremental: layers are cached, so this is fast once the image exists.
docker build -q -t "$image" "$root/docker/tools" >/dev/null

net="--network none"
[ "${DC_NET:-0}" = "1" ] && net=""
for a in "$@"; do [ "$a" = "fetch" ] && net=""; done

user=""
[ "$(uname -s)" = "Linux" ] && user="--user $(id -u):$(id -g)"

tty=""
[ -t 0 ] && [ -t 1 ] && tty="-it"

# shellcheck disable=SC2086
MSYS_NO_PATHCONV=1 exec docker run --rm $tty $net $user \
    -v "$root:/w" -w /w "$image" "$@"
