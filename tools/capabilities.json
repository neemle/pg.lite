{
  "schemaVersion": 1,
  "capabilities": [
    { "id": "scram", "description": "SCRAM-SHA-256 password authentication is implemented in the server.",
      "probe": { "fileExists": "src/backend/libpq/auth-scram.c" } },
    { "id": "gen-random-uuid", "description": "gen_random_uuid() is a built-in function (no uuid-ossp or pgcrypto needed).",
      "probe": { "fileContains": { "anyOf": ["src/include/catalog/pg_proc.dat", "src/include/catalog/pg_proc.h"], "regex": "gen_random_uuid" } } },
    { "id": "on-conflict", "description": "INSERT ... ON CONFLICT is in the grammar.",
      "probe": { "fileContains": { "anyOf": ["src/backend/parser/gram.y"], "regex": "ON\\s+CONFLICT" } } },
    { "id": "merge", "description": "MERGE statement is in the grammar.",
      "probe": { "fileContains": { "anyOf": ["src/backend/parser/gram.y"], "regex": "MergeStmt" } } },
    { "id": "identity-columns", "description": "GENERATED ... AS IDENTITY columns are in the grammar.",
      "probe": { "fileContains": { "anyOf": ["src/backend/parser/gram.y"], "regex": "GENERATED\\s+generated_when\\s+AS\\s+IDENTITY" } } },
    { "id": "builtin-locale-provider", "description": "The builtin collation provider (C, C.UTF-8) exists.",
      "probe": { "fileContains": { "anyOf": ["src/include/catalog/pg_collation.h"], "regex": "COLLPROVIDER_BUILTIN" } } },
    { "id": "with-queries", "description": "WITH (common table expressions) are in the grammar.",
      "probe": { "fileContains": { "anyOf": ["src/backend/parser/gram.y"], "regex": "with_clause" } } },
    { "id": "savepoint", "description": "SAVEPOINT / ROLLBACK TO SAVEPOINT are in the grammar.",
      "probe": { "fileContains": { "anyOf": ["src/backend/parser/gram.y"], "regex": "SAVEPOINT" } } },
    { "id": "information-schema", "description": "information_schema is created at bootstrap.",
      "probe": { "fileExists": "src/backend/catalog/information_schema.sql" } },
    { "id": "icu", "description": "ICU can be selected at build time.",
      "probe": { "configureOption": "--with-icu" } },
    { "id": "lz4", "description": "LZ4 can be selected at build time.",
      "probe": { "configureOption": "--with-lz4" } },
    { "id": "zstd", "description": "Zstandard can be selected at build time.",
      "probe": { "configureOption": "--with-zstd" } },
    { "id": "ssl", "description": "TLS support can be selected at build time (either option spelling).",
      "probe": { "configureOptionAnyOf": ["--with-ssl", "--with-openssl"] } }
  ]
}
