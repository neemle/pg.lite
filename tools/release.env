# Build settings of the release this branch builds (sourced by the build scripts). PostgreSQL 9.0 is old C: a current compiler needs
# the language level and the downgraded errors, and the build has no threads.
RELEASE_NATIVE_CONFIGURE="--disable-thread-safety"
RELEASE_NATIVE_CFLAGS="-std=gnu17 -fno-aggressive-loop-optimizations -Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=int-conversion -Wno-error=incompatible-pointer-types"
# WebAssembly: semaphore-based spinlocks (one process, so no cost that matters)
RELEASE_WASM_CONFIGURE="--disable-thread-safety --disable-spinlocks"
RELEASE_WASM_CFLAGS="-std=gnu17 -Wno-error=implicit-function-declaration -Wno-error=implicit-int -Wno-error=int-conversion -Wno-error=incompatible-pointer-types"
