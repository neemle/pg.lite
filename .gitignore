# Fetched upstream sources and build trees: never committed (see scripts/check-no-pg-source.sh).
/tools/cache/
/tools/build/
/tools/.work/

# Build artifacts; the directory stays, the contents do not.
/tools/dist/*
!/tools/dist/.gitkeep

# Tooling
node_modules/
*.o
*.a
*.log
.DS_Store
/tools/xsfx-*.tar.gz
.local/

# Playwright output
tools/tests/browser/test-results/
playwright-report/

# Unattended runs (tools/scripts/overnight.sh): results, summary and logs are local to the machine that ran them
/tools/reports/overnight/logs/
/tools/reports/overnight/.lock/
/tools/reports/overnight/results.tsv
/tools/reports/overnight/summary.txt
